{
  "name": "Zendesk Integration",
  "api_name": "zendesk",
  "version": "1.0.0",
  "description": "Manage Zendesk support tickets from Kizen agentic workflows.",
  "published": false,
  "release_branches": ["main"],
  "release_environments": ["staging"],
  "engine": "1.0.0",
  "entry": "src/",
  "release_notes_directory": "releaseNotes/",
  "config_template": {},
  "base_config": {},
  "developer_business_id": {
    "staging": "0fbf2bd5-f7c4-4bb1-a354-6d3d79120a41"
  },
  "services": [
    {
      "service_name": "zendesk_api",
      "display_name": "Zendesk API",
      "required_entitlement": null,
      "auth_type": "oauth",
      "auth_level": "business",
      "base_service_url": "https://{{zendesk_subdomain}}.zendesk.com/api/v2",
      "auth_credentials": {
        "client_id": "kizen_integration_dev",
        "client_secret": {
          "encrypted": true,
          "value": ""
        },
        "content_type": "application/json",
        "scopes": "tickets:read tickets:write users:read users:write",
        "authorize_url": "https://kizen-79102.zendesk.com/oauth/authorizations/new",
        "token_url": "https://kizen-79102.zendesk.com/oauth/tokens",
        "token_field_name": "access_token",
        "success_redirect_path": "/oauth/success",
        "error_redirect_path": "/oauth/error"
      }
    }
  ]
}
