{
  "name": "Zendesk Integration",
  "api_name": "zendesk",
  "version": "1.0.0",
  "description": "Manage Zendesk support tickets from Kizen agentic workflows.",
  "published": true,
  "release_branches": ["main"],
  "release_environments": ["dev", "prod"],
  "engine": "1.0.0",
  "entry": "src/",
  "release_notes_directory": "releaseNotes/",
  "config_template": {},
  "base_config": {
    "secrets": ["zendesk_subdomain"]
  },
  "developer_business_id": {
    "staging": "0fbf2bd5-f7c4-4bb1-a354-6d3d79120a41",
    "integration": "6895f9c9-968b-4eba-9541-4782ecd9bf01"
  },
  "services": [
    {
      "service_name": "zendesk_api",
      "display_name": "Zendesk API",
      "required_entitlement": null,
      "auth_type": "oauth",
      "auth_level": "business",
      "base_service_url": "https://zendesk.com/api/v2",
      "sub_domain_regex_validation": "^[a-zA-Z0-9-]+$",
      "auth_credentials": {
        "client_id": "zdg-kizen-integration",
        "client_secret": {
          "encrypted": true,
          "value": ""
        },
        "content_type": "application/json",
        "scopes": "read tickets:read tickets:write users:read users:write",
        "authorize_url": "https://{{secret.zendesk_subdomain}}.zendesk.com/oauth/authorizations/new",
        "token_url": "https://{{secret.zendesk_subdomain}}.zendesk.com/oauth/tokens",
        "token_field_name": "access_token",
        "success_redirect_path": "/oauth/success",
        "error_redirect_path": "/oauth/error"
      }
    }
  ]
}
